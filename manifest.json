{
  "manifest_version": 3,
  "name": "Devoirly",
  "short_name": "Devoirly",
  "version": "3.3.0",
  "description": "Transforme les devoirs Educartable en événements Google Calendar dans le calendrier choisi par l’utilisateur.",
  "minimum_chrome_version": "105",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://*.educartable.com/*",
    "https://www.googleapis.com/calendar/*"
  ],
  "oauth2": {
    "client_id": "139819627304-bqdrbua9f2fh67q4rs60v57m99uk8inl.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/calendar.calendarlist.readonly"
    ]
  },
  "action": {
    "default_title": "Devoirly",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.educartable.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
